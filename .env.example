# --- Required ---

# Mistral API key (server-side only, never exposed to browsers)
MISTRAL_API_KEY=

# Shared token your React apps must present (header `Authorization: Bearer ...`
# for HTTP, `?token=...` for WebSocket). Use a long random string, e.g.:
#   openssl rand -hex 32
AUTH_TOKEN=

# Comma-separated list of allowed browser origins, e.g.:
#   https://app1.example.com,https://app2.example.com,http://localhost:5173
# Use `*` to disable the origin check (dev only).
ALLOWED_ORIGINS=http://localhost:3000

# --- Optional: Gladia (enables the /v1/gladia/* endpoints) ---

# Gladia API key (https://app.gladia.io). Leave empty to keep the Gladia
# endpoints disabled; the Mistral endpoints work either way.
# GLADIA_API_KEY=

# --- Optional (defaults shown) ---

# PORT=3000
# BATCH_MODEL=voxtral-mini-latest
# REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
# TTS_MODEL=voxtral-mini-tts-2603
# TTS_VOICE=
# TTS_FORMAT=pcm
# MAX_TTS_CHARS=8000
# MAX_UPLOAD_BYTES=26214400
# MAX_SESSIONS=20
# MAX_SESSION_MS=600000
# IDLE_TIMEOUT_MS=60000
# DEFAULT_TARGET_DELAY_MS=480

# Gladia tuning
# GLADIA_LIVE_MODEL=            # empty = Gladia default (solaria-1)
# GLADIA_REGION=                # empty = default; or eu-west / us-west
# GLADIA_POLL_INTERVAL_MS=1000
# GLADIA_POLL_TIMEOUT_MS=300000

# Upstream overrides (tests / mock server)
# MISTRAL_BASE_URL=https://api.mistral.ai
# MISTRAL_WS_URL=wss://api.mistral.ai
# GLADIA_BASE_URL=https://api.gladia.io
